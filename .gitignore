# Public sources only. Local assets, notes, tools and build outputs stay local.
# Exception: the lecture source archive is tracked for internal preparation,
# outside the website's explicit render and resource lists.
*
!*/
!/.gitignore
!index.qmd
!slides/lectures/Lecture_*/Lecture_*.qmd
!.github/workflows/*.yml
!exercises/Sheet_*/Sheet_*.pdf
!/Makefile
!/README.md
!/LICENSE
!/THIRD_PARTY.md
!/reference/Lecture-07.pdf
!/reference/Lecture-08.pdf
!/reference/Lecture-09.pdf
!/reference/lecture-notes/**
!/scripts/check_site.py
!/scripts/export_pdf.py
!/scripts/requirements-pdf.txt
!slides/lectures/Lecture_3/lecture.css
!slides/lectures/Lecture_3/figures/*.svg
!slides/lectures/Lecture_3/widgets/*.html
!slides/lectures/Lecture_3/widgets/*.png
!slides/lectures/Lecture_3/widgets/*.css
!slides/lectures/Lecture_3/widgets/*.js
!slides/lectures/Lecture_4/lecture.css
